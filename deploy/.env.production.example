# Copy to deploy/.env (never commit that file) and replace every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 24     (SESSION_SECRET and PII key: openssl rand -base64 32)

# --- Domains (DNS A/AAAA records must point at this host before the first start)
SHOP_DOMAIN=shop.example.vn
AUTH_DOMAIN=auth.example.vn
API_DOMAIN=api.example.vn
ACME_EMAIL=ops@example.vn

# --- Databases and cache
DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- Keycloak (the bootstrap admin is created once; change it after the first login)
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_PROVISIONER_SECRET=CHANGE_ME
KEYCLOAK_WEB_DIRECT_SECRET=CHANGE_ME

# --- Web and encryption (SESSION_SECRET and PII_KEY_LOCAL_1 are 32 random bytes in base64;
#     losing PII_KEY_LOCAL_1 makes encrypted addresses and bank accounts unreadable: back it up)
SESSION_SECRET=CHANGE_ME
PII_KEY_LOCAL_1=CHANGE_ME

# --- Payments (payOS has no sandbox: these are real credentials)
PAYMENT_PROVIDER=payos
PAY_OS_CLIENT_ID=
PAY_OS_API_KEY=
PAY_OS_CHECKSUM_KEY=
# Automatic refund payouts: leave false until the payout channel is verified (docs/24).
PAYOS_PAYOUT_ENABLED=false
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# --- Shipping (production GHTK; the webhook URL to register is
#     https://<SHOP_DOMAIN>/api/v1/shipping/ghtk/webhook?hash=<GHTK_WEBHOOK_TOKEN>)
GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=
GHTK_PARTNER_CODE=
GHTK_WEBHOOK_TOKEN=

# --- Mail (any SMTP provider). The API sends notification mail; Keycloak sends verification and
#     password-reset mail with the same server (set by scripts/prepare-prod-realm.mjs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=VShop <no-reply@example.vn>

# --- Optional CAPTCHA (Cloudflare Turnstile keys)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
