{
  "realm": "vshop",
  "enabled": true,
  "displayName": "vshop",
  "loginTheme": "vshop",
  "internationalizationEnabled": true,
  "supportedLocales": ["vi"],
  "defaultLocale": "vi",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "passwordPolicy": "length(8) and digits and lowerCase and notUsername",
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "BUYER"
      },
      {
        "name": "SELLER"
      },
      {
        "name": "ADMIN"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vshop-provisioner",
      "name": "VShop account provisioning (server only)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "vshop-web",
      "name": "VShop",
      "baseUrl": "http://localhost:3100",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3100/api/auth/callback"],
      "webOrigins": ["http://localhost:3100"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*"
      },
      "protocolMappers": [
        {
          "name": "vshop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vshop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "vshop-amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "amr"
          }
        }
      ]
    },
    {
      "clientId": "vshop-mobile",
      "name": "VShop iOS & Android",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["vshop://auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "vshop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "vshop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "vshop-amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "claim.name": "amr"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-vshop-provisioner",
      "enabled": true,
      "serviceAccountClientId": "vshop-provisioner",
      "clientRoles": { "realm-management": ["manage-users", "view-users", "view-realm"] }
    }
  ],
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": false,
  "browserFlow": "browser-admin-mfa",
  "authenticatorConfig": [
    {
      "alias": "vshop-admin-role",
      "config": {
        "condUserRole": "ADMIN",
        "negate": "false"
      }
    },
    {
      "alias": "vshop-otp-amr",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "36000"
      }
    },
    {
      "alias": "vshop-pwd-amr",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "36000"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-admin-mfa",
      "description": "Browser login; ADMIN users must also pass TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-admin-mfa forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-admin-mfa forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "vshop-pwd-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "browser-admin-mfa admin otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-admin-mfa admin otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "vshop-admin-role",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "vshop-otp-amr",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ]
}
